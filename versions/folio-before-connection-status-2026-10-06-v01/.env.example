# folio server only. Keep the real .env file private; it is ignored by Git.
# Data4Library: 회원가입 후 인증키 신청·발급이 필요한 국내 책 데이터원.
FOLIO_DATA4LIBRARY_AUTH_KEY=
# Gemini: Google AI Studio 무료 등급의 키로 책 소개 기반 한국어 추천 이유를 작성.
GEMINI_API_KEY=
# 이전 카카오 연동 준비 코드용. 현재 folio 화면에서는 사용하지 않음.
FOLIO_KAKAO_REST_KEY=
PORT=8767
